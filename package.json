{
  "name": "browser-face-liveness-electron",
  "version": "1.0.0",
  "description": "Electron desktop demo: webcam face liveness (anti-spoofing) using a pretrained MiniFASNet ONNX model running locally with ONNX Runtime Web.",
  "main": "src/main.js",
  "scripts": {
    "vendor": "node scripts/copy-ort.js",
    "prestart": "npm run vendor",
    "start": "electron .",
    "pretest": "npm run vendor",
    "test": "node --test test/*.test.js",
    "build": "npm run vendor && electron-builder --mac zip --arm64",
    "build:win": "npm run vendor && electron-builder --win zip --x64",
    "source-zip": "node scripts/source-zip.js"
  },
  "author": "Yash Dhankhar",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "onnxruntime-node": "^1.20.1",
    "onnxruntime-web": "^1.20.1"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "onnxruntime-node@1.20.1": true
  },
  "productName": "Face Liveness Detector",
  "build": {
    "appId": "edu.rishihood.faceliveness",
    "productName": "Face Liveness Detector",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "models/**/*",
      "package.json",
      "!src/**/*.map"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": "-",
      "extendInfo": {
        "NSCameraUsageDescription": "The camera is used to check whether the face in front of it is live. Frames are analysed on this Mac only and are never saved or uploaded."
      },
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
